#!/bin/bash
# Docker 模式的生命周期钩子：准备数据目录、纠正 compose 里的数据目录默认值、同步端口

COMPOSE_FILE="${TRIM_APPDEST}/docker/docker-compose.yaml"
PORT_SAVE="${TRIM_PKGVAR}/.port"
DATA_DIR_SAVE="${TRIM_PKGVAR}/.datadir"
# 与 compose 里的插值默认值保持一致（见 docker/docker-compose.yaml）
FALLBACK_DATA_DIR="/var/apps/van-nav/var/data"

# 取第一个数据共享目录，形如 /vol1/@appshare/Van Nav（多个路径时用 : 分隔）
resolve_data_dir() {
    local dir="${TRIM_DATA_SHARE_PATHS%%:*}"
    if [ -z "$dir" ]; then
        dir="$FALLBACK_DATA_DIR"
    fi
    echo "$dir"
}

# 把 compose 里插值的默认值改成真实共享目录，安装/升级后重新解包也不会失效
apply_data_dir() {
    local dir
    dir="$(resolve_data_dir)"
    mkdir -p "$dir" 2>/dev/null || true
    echo "$dir" > "$DATA_DIR_SAVE"
    if [ -f "$COMPOSE_FILE" ] && [ "$dir" != "$FALLBACK_DATA_DIR" ]; then
        sed -i "s|${FALLBACK_DATA_DIR}|${dir}|g" "$COMPOSE_FILE"
    fi
    install_log "Data dir: ${dir} -> /app/data"
}

apply_port() {
    local port="$1"
    [ -z "$port" ] && return
    sed -i 's/"[^"]*:6412"/"'"${port}"':6412"/' "$COMPOSE_FILE"
    echo "${port}" > "$PORT_SAVE"
    install_log "Patched docker-compose.yaml: port=${port}"
}

service_postinst() {
    apply_data_dir
}

service_postupgrade() {
    # 升级会重新解包 app.tgz，compose 里的默认值会回到出厂状态，这里重新纠正
    apply_data_dir
    if [ -f "$PORT_SAVE" ]; then
        apply_port "$(cat "$PORT_SAVE")"
    fi
}

service_postconfig() {
    if [ -n "${wizard_port:-}" ]; then
        apply_port "${wizard_port}"
    fi
}
