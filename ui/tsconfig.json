{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  // auto-imports.d.ts 是 unplugin-auto-import 生成的全局声明（当前为空，项目里的 API 都是
  // 显式 import 的）；components.d.ts 由 unplugin-vue-components 生成，暂不纳入：
  // 一旦纳入，el-table 插槽 row 会按 Element Plus 的 DefaultRow 检查，
  // 后台三个页面共 18 处调用需要改成 Tool/Catelog/SearchEngine 显式收窄，
  // 属于独立的一次类型治理，待单独处理后再放开
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts", "auto-imports.d.ts"]
}